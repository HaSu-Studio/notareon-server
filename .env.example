COMPOSE_PROJECT_NAME=notareon-server
POSTGRES_IMAGE=postgres:16-alpine
BACKEND_IMAGE=notareon/backend:local
API_PORT=3000

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=notareon

NODE_ENV=development
PORT=3000
DB_SYNCHRONIZE=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
