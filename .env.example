# Docker Compose читает этот файл автоматически; Nest при npm run start:dev — тоже
COMPOSE_PROJECT_NAME=notareon-server

POSTGRES_IMAGE=postgres:16-alpine

# БД: одни переменные для everyone
# — образ postgres в Docker получает из них POSTGRES_USER / PASSWORD / DB
# — Nest в контейнере: в compose зашиты DB_HOST=postgres и DB_PORT=5432 (сеть Docker)
# — Nest на машине + БД в Docker: DB_HOST + DB_PORT = твой проброшенный порт (DBeaver так же)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=notareon

BACKEND_IMAGE=notareon/backend:local
API_PORT=3000

NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3000
